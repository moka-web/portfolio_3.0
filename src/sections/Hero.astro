---
// src/components/sections/Hero.astro
// Full-viewport hero with headline, subtext, CTA and atmospheric background.
import BrandMarquee from '../components/ui/BrandMarquee.astro';
---

<section
  id="hero"
  aria-label="Hero principal"
  class="hero-bg grain relative w-full h-[calc(100vh-80px)] md:h-[calc(100vh-132px)] flex flex-col overflow-hidden"
>

  <!-- Decorative vertical line -->
  <div class="absolute left-8 top-0 bottom-0 w-px bg-gold/10 hidden lg:block"></div>

  <!-- Decorative grid dots -->
  <div
    aria-hidden="true"
    class="hero-grid-dots absolute inset-0 opacity-[0.025]"
  ></div>

  <!-- Bottom vignette -->
  <div
    aria-hidden="true"
    class="hero-vignette absolute bottom-0 left-0 right-0 h-48 pointer-events-none z-[2]"
  ></div>

  <!-- ── Content ── -->
  <div class="flex-1 min-h-0 flex items-center relative z-10 py-4 md:py-8">
    <div class="section-container w-full grid lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] gap-12 items-center">

    <div class="max-w-4xl relative">
      <span aria-hidden="true" class="absolute -top-4 right-0 font-serif font-bold text-[8rem] md:text-[11rem] leading-none text-cream/[0.06] select-none pointer-events-none">01</span>

      <!-- Eyebrow -->
      <p class="eyebrow animate-fade-up mb-2 md:mb-4">
        <span class="text-cream-dim mr-2">01 /</span> Salud digital a medida
      </p>

      <!-- Main headline -->
      <h1 class="heading-xl animate-fade-up-2 mb-3 md:mb-6">
        GESTIÓN <br/>

        <em class="not-italic text-gold">DE </em>
          SALUD 
           <em class="not-italic text-gold">DIGITAL</em>
      </h1>

      <!-- Subheadline -->
      <p class="body-text animate-fade-up-3 max-w-xl mb-3 md:mb-8 text-[1rem]">
        Callvu es un estudio de desarrollo de software especializado en soluciones
        digitales para centros de salud integral y profesionales autónomos. Transformamos
        la gestión operativa: menos procesos manuales, más flujos automatizados, seguros
        y eficientes.
      </p>

      <p class="font-mono text-[0.7rem] uppercase tracking-w3 text-cream-dim mb-4 md:mb-10">
        Centros integrales · Terapias especializadas · Consultorios
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center gap-4 animate-fade-up-4">
        <a href="#valor"    class="btn-primary">Propuesta de valor</a>
        <a href="#contact" class="btn-outline">Hablemos →</a>
      </div>

    </div>

    <!-- Right column: stack highlight card -->
    <div class="hidden lg:flex justify-end">
      <div class="bg-gradient-to-br from-white to-gold/[0.04] border border-gold/40 shadow-[0_18px_45px_rgba(201,168,76,0.18)] rounded-2xl px-6 py-5 max-w-xs animate-fade-up-3 hover:-translate-y-1 hover:border-gold/70 hover:shadow-[0_24px_50px_rgba(201,168,76,0.22)] transition-all duration-400">
        <p class="font-mono text-[0.7rem] uppercase tracking-w3 text-gold mb-3">
          Evolución por etapas
        </p>
        <p class="font-serif text-xl text-cream mb-4 leading-snug">
          Implementá solo lo que necesitás hoy y escalá a medida que tu centro crece.
        </p>
        <div class="flex flex-wrap gap-2">
          {['Fase inicial', 'Crecimiento', 'Escalabilidad'].map(tech => (
            <span class="skill-pill cursor-default">{tech}</span>
          ))}
        </div>
      </div>
    </div>

    </div>
  </div>

  <!-- Brand marquee -->
  <div class="relative z-10 w-full pb-4">
    <BrandMarquee />
  </div>

</section>