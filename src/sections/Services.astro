---
// src/components/sections/Services.astro

const delayClasses = ['reveal-delay-1', 'reveal-delay-2', 'reveal-delay-3']

const services = [
  {
    number: '01',
    title: 'Callvu Portal',
    subtitle: 'Módulo de captación',
    description:
      'Landing pages de alto rendimiento con Next.js, optimizadas para móvil y pensadas para convertir visitas en pacientes.',
    tags: ['Next.js', 'Performance', 'Conversión', 'SEO técnico'],
  },
  {
    number: '02',
    title: 'Callvu Agenda',
    subtitle: 'Motor de gestión',
    description:
      'Turnos inteligentes con lógica de negocio en NestJS: agendas múltiples e integración vía APIs oficiales con WhatsApp y Google Calendar.',
    tags: ['NestJS', 'APIs', 'WhatsApp', 'Google Calendar'],
  },
  {
    number: '03',
    title: 'Callvu Dossier',
    subtitle: 'Historia clínica digital',
    description:
      'Registro centralizado de legajos y evoluciones. Priorizamos la seguridad de datos con cifrado avanzado y privacidad del paciente.',
    tags: ['Cifrado', 'Auditoría', 'Residencia de datos', 'PostgreSQL'],
  },
]
---

<section id="services" aria-label="Callvu Health Suite" class="min-h-screen flex flex-col justify-center py-20 bg-glow-blue relative overflow-hidden">
  <div class="section-container">

    <div class="divider-gold mb-20"></div>

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-16">
      <div class="relative">
        <span aria-hidden="true" class="absolute -top-4 right-0 font-serif font-bold text-[8rem] md:text-[11rem] leading-none text-cream/[0.06] select-none pointer-events-none">03</span>
        <p class="eyebrow mb-4 reveal">
          <span class="text-cream/40 mr-2">03 /</span> Health Suite
        </p>
        <h2 class="font-serif font-semibold text-4xl md:text-6xl leading-tight tracking-w2 uppercase reveal reveal-delay-1">
          Ecosistema<br/>
          <em class="not-italic text-gold">modular.</em>
        </h2>
      </div>
      <p class="body-text max-w-sm text-right hidden md:block text-base md:text-lg">
        Implementación escalable:<br/>
        activás solo lo que el centro necesita hoy.
      </p>
    </div>

    <!-- Cards grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-white/[0.05]">
      {services.map((service, i) => (
        <article class={`card group cursor-default bg-navy reveal ${delayClasses[i] ?? ''}`}>

          <!-- Number -->
          <p class="font-serif text-6xl text-gold/20 font-semibold mb-4
                     group-hover:text-gold/35 transition-colors duration-300 leading-none">
            {service.number}
          </p>

          <!-- Title -->
          <h3 class="font-serif text-2xl md:text-3xl tracking-w2 uppercase text-cream mb-1">
            {service.title}
          </h3>
          <p class="font-mono text-xs md:text-sm uppercase tracking-wider text-gold/60 mb-3">
            {service.subtitle}
          </p>

          <!-- Description -->
          <p class="body-text text-base md:text-lg mb-6">{service.description}</p>

          <!-- Tags -->
          <ul class="flex flex-wrap gap-2 list-none m-0 p-0">
            {service.tags.map(tag => (
              <li>
                <span class="skill-pill">{tag}</span>
              </li>
            ))}
          </ul>

        </article>
      ))}
    </div>

  </div>
</section>