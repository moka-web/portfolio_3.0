---
// src/sections/FactoryStack.astro
// Seccion de stack tecnologico para la landing de Software Factory.

const delayClasses = ['reveal-delay-1', 'reveal-delay-2', 'reveal-delay-3', 'reveal-delay-4']

const categories = [
  {
    label: 'Frontend & UI',
    items: ['Next.js', 'React', 'TypeScript', 'Tailwind CSS', 'SSR / SSG'],
  },
  {
    label: 'Backend & APIs',
    items: ['NestJS', 'Node.js', 'REST / GraphQL', 'Webhooks', 'Microservicios'],
  },
  {
    label: 'Base de Datos & Cifrado',
    items: ['PostgreSQL', 'Redis', 'Cifrado en tránsito y reposo', 'ORM / Prisma'],
  },
  {
    label: 'DevOps & Infraestructura',
    items: ['Docker', 'CI/CD Pipelines', 'AWS / Cloud', 'Observabilidad'],
  },
]
---

<section id="stack" aria-label="Stack tecnológico" class="min-h-screen flex flex-col justify-center py-20 bg-glow-center relative overflow-hidden">
  <div class="section-container">

    <div class="divider-gold mb-20"></div>

    <!-- Header -->
    <div class="mb-16 relative">
      <span aria-hidden="true" class="absolute -top-4 right-0 font-serif font-bold text-[8rem] md:text-[11rem] leading-none text-cream/[0.06] select-none pointer-events-none">05</span>
      <p class="eyebrow mb-4 reveal">
        <span class="text-cream/40 mr-2">05 /</span> Stack
      </p>
      <h2 class="font-serif font-semibold text-4xl md:text-6xl leading-tight tracking-w2 uppercase reveal reveal-delay-1">
        Stack<br/>
        <em class="not-italic text-gold">tecnológico.</em>
      </h2>
    </div>

    <!-- Grid of categories -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      {categories.map((cat, i) => (
        <div class={`reveal ${delayClasses[i] ?? ''}`}>

          <!-- Category label -->
          <p class="font-mono text-xs md:text-sm uppercase tracking-w3 text-gold/70 mb-5 pb-3
                     border-b border-gold/20">
            {cat.label}
          </p>

          <!-- Skills -->
          <ul class="flex flex-wrap gap-2 list-none m-0 p-0">
            {cat.items.map(item => (
              <li>
                <span class="skill-pill cursor-default">{item}</span>
              </li>
            ))}
          </ul>

        </div>
      ))}
    </div>

    <!-- Learning now strip -->
    <div class="mt-16 pt-10 border-t border-white/[0.05]">
      <p class="font-mono text-xs md:text-sm uppercase tracking-w3 text-cream/40 mb-4">
        Explorando e integrando →
      </p>
      <div class="flex flex-wrap gap-2">
        {['Arquitectura Event-Driven', 'Edge Computing', 'AI Assistants / RAG'].map(item => (
          <span class="skill-pill border-dashed opacity-50">{item}</span>
        ))}
      </div>
    </div>

  </div>
</section>
