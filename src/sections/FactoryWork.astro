---
// src/sections/FactoryWork.astro
// Propuesta de valor y diferenciación para la landing de Software Factory.

interface Pillar {
  number: string
  title: string
  description: string
  tags: string[]
  featured: boolean
}

const delayClasses = ['reveal-delay-1', 'reveal-delay-2', 'reveal-delay-3']

const pillars: Pillar[] = [
  {
    number: '01',
    title: 'Arquitectura Senior & Código Limpio',
    description:
      'Diseñamos soluciones con principios SOLID y patrones de diseño modernos. Desarrollamos código limpio, modular y completamente libre de deuda técnica improvisada.',
    tags: ['Clean Architecture', 'Patrones de Diseño', 'Escalabilidad'],
    featured: true,
  },
  {
    number: '02',
    title: 'Seguridad & Estándares Enterprise',
    description:
      'Implementamos prácticas estrictas de protección de datos, cifrado en tránsito y en reposo, e integración continua siguiendo pautas OWASP para proteger tu negocio.',
    tags: ['Cifrado', 'Hardening', 'Estándares OWASP'],
    featured: false,
  },
  {
    number: '03',
    title: 'Entregas Iterativas & Agilidad',
    description:
      'Trabajamos con sprints cortos, demostraciones frecuentes y comunicación transparente. Tenés visibilidad total del progreso técnico y del valor entregado en cada iteración.',
    tags: ['Sprints Cortos', 'Transparencia', 'CI/CD'],
    featured: false,
  },
]
---

<section id="factory-valor" aria-label="Diferenciación Software Factory" class="min-h-screen flex flex-col justify-center py-20 bg-glow-gold relative overflow-hidden">
  <div class="section-container">

    <div class="divider-gold mb-20"></div>

    <!-- Header -->
    <div class="mb-16 relative">
      <span aria-hidden="true" class="absolute -top-4 right-0 font-serif font-bold text-[8rem] md:text-[11rem] leading-none text-cream/[0.06] select-none pointer-events-none">04</span>
      <p class="eyebrow mb-4 reveal">
        <span class="text-cream/40 mr-2">04 /</span> Diferenciación
      </p>
      <h2 class="font-serif font-semibold text-4xl md:text-6xl leading-tight tracking-w2 uppercase reveal reveal-delay-1">
        Rigor técnico<br/>
        <em class="not-italic text-gold">+ entregas ágiles.</em>
      </h2>
      <p class="body-text max-w-2xl mt-6 reveal reveal-delay-2 text-lg md:text-xl">
        Nuestra propuesta combina estándares internacionales de ingeniería con una metodología de trabajo flexible orientada a resultados de negocio.
      </p>
    </div>

    <!-- Pillars list -->
    <div class="space-y-px">
      {pillars.map((pillar, i) => (
        <article
          class={`group flex flex-col md:flex-row md:items-center gap-6 py-8
                 border-t border-white/[0.07] hover:bg-navy-mid/40 px-0 hover:px-6
                 transition-all duration-300 cursor-default reveal ${delayClasses[i] ?? ''}`}
        >

          <span class="font-mono text-sm text-cream/40 w-10 shrink-0 hidden md:block">
            {pillar.number}
          </span>

          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-center gap-3 mb-2">
              <h3 class="font-serif text-2xl md:text-3xl tracking-wider uppercase text-cream
                          group-hover:text-gold transition-colors duration-300">
                {pillar.title}
              </h3>
              {pillar.featured && (
                <span class="font-mono text-xs uppercase tracking-widest
                              border border-gold/40 text-gold/70 px-2 py-0.5">
                  Fundamental
                </span>
              )}
            </div>
            <p class="body-text text-base md:text-lg max-w-xl">{pillar.description}</p>
            <ul class="flex flex-wrap gap-2 mt-4 list-none m-0 p-0">
              {pillar.tags.map(tag => (
                <li><span class="skill-pill">{tag}</span></li>
              ))}
            </ul>
          </div>

        </article>
      ))}
    </div>

    <div class="mt-14 text-center">
      <a href="https://www.linkedin.com/in/callvu-software" target="_blank" rel="noopener" class="btn-outline">
        Seguinos en LinkedIn →
      </a>
    </div>

  </div>
</section>
