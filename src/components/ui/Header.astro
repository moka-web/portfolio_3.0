---
// src/components/ui/Header.astro
// Estructura idéntica al header de la White House:
//   Fila 1 (topbar): [MENU ☰]  [Logo centrado]  [SEARCH 🔍]
//   Fila 2 (nav):    enlaces centrados con underline gold en hover

interface Props {
  customNavLinks?: { label: string; href: string }[]
}

const { customNavLinks } = Astro.props
const { pathname }       = Astro.url

const isFactory = pathname.startsWith('/software-factory')
const isSalud   = pathname.startsWith('/salud')

let navLinks = customNavLinks

if (!navLinks) {
  if (isFactory) {
    navLinks = [
      { label: 'Servicios',      href: '#factory-services' },
      { label: 'Diferenciación', href: '#factory-valor'    },
      { label: 'Stack',          href: '#stack'            },
      { label: 'Contacto',       href: '#contact'          },
      { label: 'Salud Digital',  href: '/salud'            },
    ]
  } else if (isSalud) {
    navLinks = [
      { label: 'Nosotros',         href: '#about'            },
      { label: 'Suite',            href: '#services'         },
      { label: 'Valor',            href: '#valor'            },
      { label: 'Stack',            href: '#stack'            },
      { label: 'Contacto',         href: '#contact'          },
      { label: 'Software Factory', href: '/software-factory' },
    ]
  } else {
    navLinks = [
      { label: 'Salud Digital',    href: '/salud'            },
      { label: 'Software Factory', href: '/software-factory' },
    ]
  }
}
---

<!-- ════════════════════════════════════════
     FILA 1 · TOPBAR  (MENU | Logo | SEARCH)
════════════════════════════════════════ -->
<header
  role="banner"
  class="fixed top-0 left-0 right-0 z-50
         bg-navy/90 backdrop-blur-md
         "
>

  <!-- Top row: 3-column grid exactly like WH -->
  <div class="grid grid-cols-[1fr_auto_1fr] items-center h-20 px-8">

    <!-- Left: MENU button -->
    <button
      id="menuBtn"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobileMenu"
      class="flex items-center gap-2.5 bg-transparent border-0 cursor-pointer
             text-cream hover:text-gold transition-colors duration-300 w-fit"
    >
      <span class="flex flex-col gap-[5px]" aria-hidden="true">
        <span id="bar1" class="block w-[18px] h-px bg-current transition-all duration-300"></span>
        <span id="bar2" class="block w-[18px] h-px bg-current transition-all duration-300"></span>
        <span id="bar3" class="block w-[18px] h-px bg-current transition-all duration-300"></span>
      </span>
      <span class="font-sans text-[0.68rem] uppercase tracking-[0.16em] hidden sm:inline">
        Menu
      </span>
    </button>

    <!-- Center: Brand / Logo -->
    <a
      href="/"
      aria-label="Callvu – Inicio"
      class="text-center group"
    >
      <p class="font-serif font-semibold text-[2.2rem] uppercase tracking-w2 leading-tight
                text-cream group-hover:text-gold transition-colors duration-300">
        Callvu<span class="text-gold">.</span>
      </p>
      <p class="font-sans text-[0.6rem] uppercase tracking-w3 text-cream/55 mt-0.5">
        Software Studio
      </p>
    </a>

    <div></div>

  </div>

  <!-- ════════════════════════════════════════
       FILA 2 · PRIMARY NAV (enlaces centrados)
  ════════════════════════════════════════ -->
  <nav
    aria-label="Navegación principal"
    class="hidden md:block border-t border-white/[0.06]
           bg-navy/60 backdrop-blur-sm"
  >
    <ul class="flex justify-center  list-none m-0 p-0">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="nav-link block px-[1.375rem] py-[0.8rem]
                   font-sans text-[0.68rem] uppercase tracking-[0.18em]
                   text-cream/80 hover:text-cream
                   transition-colors duration-300"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

</header>

<!-- ════════════════════════════════════════
     MOBILE MENU DRAWER
════════════════════════════════════════ -->
<div
  id="mobileMenu"
  role="navigation"
  aria-label="Menú móvil"
  class="hidden fixed top-20 left-0 right-0 z-50
         bg-navy/98 backdrop-blur-md
         border-b border-gold/20
         py-7 px-8"
>
  <ul class="flex flex-col gap-5 list-none m-0 p-0">
    {navLinks.map(link => (
      <li>
        <a
          href={link.href}
          class="mobile-nav-link
                 font-sans text-[0.75rem] uppercase tracking-[0.18em]
                 text-cream/75 hover:text-gold
                 transition-colors duration-300"
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</div>


<!-- Spacer: h-20 en mobile (solo topbar), h-[132px] en md+ (topbar + nav) -->
<div class="h-20 md:h-[132px]" aria-hidden="true"></div>

<script>
  /* ── Mobile menu toggle ── */
  const btn  = document.getElementById('menuBtn')!
  const menu = document.getElementById('mobileMenu')!
  const bar1 = document.getElementById('bar1')!
  const bar2 = document.getElementById('bar2')!
  const bar3 = document.getElementById('bar3')!
  let menuOpen = false

  btn.addEventListener('click', () => {
    menuOpen = !menuOpen
    menu.classList.toggle('hidden', !menuOpen)
    btn.setAttribute('aria-expanded', String(menuOpen))
    bar1.style.transform = menuOpen ? 'translateY(6px) rotate(45deg)'   : ''
    bar2.style.opacity   = menuOpen ? '0'                                : '1'
    bar3.style.transform = menuOpen ? 'translateY(-6px) rotate(-45deg)' : ''
  })

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      menuOpen = false
      menu.classList.add('hidden')
      btn.setAttribute('aria-expanded', 'false')
      bar1.style.transform = bar3.style.transform = ''
      bar2.style.opacity = '1'
    })
  })

  /* ── Escape key closes mobile menu ── */
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && menuOpen) {
      menuOpen = false
      menu.classList.add('hidden')
      btn.setAttribute('aria-expanded', 'false')
      bar1.style.transform = bar3.style.transform = ''
      bar2.style.opacity = '1'
      btn.focus()
    }
  })

</script>