---
// src/components/ui/SocialSidebar.astro
// Sidebar fijo lateral izquierdo — estilo WH — con redes sociales.
// Reemplazá los href con tus URLs reales.

const links = [
  {
    label: 'LinkedIn',
    href:  'https://www.linkedin.com/in/callvu-software',
    icon:  'linkedin',
  },
  {
    label: 'Instagram',
    href:  'https://www.instagram.com/callvusoftware/',
    icon:  'instagram',
  },
  {
    label: 'Email',
    href:  'mailto:callvusoftware@gmail.com',
    icon:  'email',
  },
]
---

<aside
  aria-label="Redes sociales"
  class="fixed left-0 top-1/2 -translate-y-1/2 z-40
         hidden md:flex flex-col
         bg-white shadow-[0_0_0_1px_rgba(15,23,42,0.05),0_10px_30px_rgba(15,23,42,0.12)]
         rounded-r-2xl
         border border-white/80 border-l-0
         py-3"
>
  {links.map(link => (
    <a
      href={link.href}
      target={link.icon === 'email' ? '_self' : '_blank'}
      rel="noopener noreferrer"
      aria-label={link.label}
      class="social-sidebar-link
             flex items-center justify-center
             w-12 h-12
             text-cream-dim
             hover:text-cream hover:bg-gold/10
             transition-all duration-300"
    >

      {/* ── LinkedIn ── */}
      {link.icon === 'linkedin' && (
        <svg class="w-[15px] h-[15px] fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      )}

      {/* ── Instagram ── */}
      {link.icon === 'instagram' && (
        <svg class="w-[15px] h-[15px] fill-none stroke-current stroke-[1.6]" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"/>
        </svg>
      )}

      {/* ── Email ── */}
      {link.icon === 'email' && (
        <svg class="w-[15px] h-[15px] fill-none stroke-current stroke-[1.6]" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
      )}

    </a>
  ))}
</aside>