---
// src/components/ui/Icon.astro
// Centralized inline SVG icon component.
// Usage: <Icon name="github" class="w-4 h-4" />

type IconName = 'github' | 'linkedin' | 'twitter' | 'instagram' | 'email' | 'external' | 'search'

interface Props {
  name: IconName
  class?: string
  'aria-hidden'?: boolean | 'true' | 'false'
}

const { name, class: className = '', 'aria-hidden': ariaHidden = true } = Astro.props

const icons: Record<IconName, { viewBox: string; filled: boolean; inner: string }> = {
  github: {
    viewBox: '0 0 24 24',
    filled: true,
    inner: `<path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>`,
  },
  linkedin: {
    viewBox: '0 0 24 24',
    filled: true,
    inner: `<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>`,
  },
  twitter: {
    viewBox: '0 0 24 24',
    filled: true,
    inner: `<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.259 5.63L18.243 2.25z"/>`,
  },
  instagram: {
    viewBox: '0 0 24 24',
    filled: false,
    inner: `<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"/>`,
  },
  email: {
    viewBox: '0 0 24 24',
    filled: false,
    inner: `<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>`,
  },
  external: {
    viewBox: '0 0 24 24',
    filled: false,
    inner: `<path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>`,
  },
  search: {
    viewBox: '0 0 24 24',
    filled: false,
    inner: `<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>`,
  },
}

const icon = icons[name]
---

{icon && (
  <svg
    viewBox={icon.viewBox}
    fill={icon.filled ? 'currentColor' : 'none'}
    stroke={icon.filled ? 'none' : 'currentColor'}
    stroke-width={icon.filled ? undefined : '1.75'}
    class={className}
    aria-hidden={ariaHidden}
    xmlns="http://www.w3.org/2000/svg"
    set:html={icon.inner}
  />
)}
