---
import BaseLayout      from '../layouts/BaseLayout.astro'
import Header          from '../components/ui/Header.astro'
import Footer          from '../components/ui/Footer.astro'
import SocialSidebar   from '../components/ui/SocialSidebar.astro'
import FactoryHero     from '../sections/FactoryHero.astro'
import FactoryServices from '../sections/FactoryServices.astro'
import FactoryWork     from '../sections/FactoryWork.astro'
import FactoryStack    from '../sections/FactoryStack.astro'
import FactoryContact  from '../sections/FactoryContact.astro'
---

<BaseLayout
  title="Callvu – Software Factory & Desarrollo a Medida"
  description="Estudio de ingeniería de software especializado en el desarrollo de soluciones digitales a medida, plataformas web complejas, backend escalables e integraciones corporativas."
>
  <Header />
  <SocialSidebar />
  <main id="main-content">
    <FactoryHero     />
    <FactoryServices />
    <FactoryWork     />
    <FactoryStack    />
    <FactoryContact  />
  </main>

  <Footer />
</BaseLayout>
